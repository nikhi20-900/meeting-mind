# MeetingMind Environment Configuration
# Obtain your free Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey

GEMINI_API_KEY="your_gemini_api_key_here"

# PostgreSQL is required in production. Leave unset for the local JSON demo store.
# DATABASE_URL="postgresql://user:password@host:5432/meeting_mind"
# Set true when the database provider requires TLS.
DATABASE_SSL="false"

# Production workspace protection. Use different randomly generated secrets of at least 32 characters.
# MEETING_MIND_ACCESS_KEY="replace-with-a-long-random-editor-key"
# MEETING_MIND_SESSION_SECRET="replace-with-a-different-long-random-session-secret"
# Optional read-only key; it can view workspace data but cannot change it.
# MEETING_MIND_VIEW_KEY="replace-with-a-long-random-viewer-key"
