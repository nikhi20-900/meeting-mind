# MeetingMind Environment Configuration
# Obtain your free Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey

GEMINI_API_KEY="your_gemini_api_key_here"

# PostgreSQL is required in production. Leave unset for the local JSON demo store.
# DATABASE_URL="postgresql://user:password@host:5432/meeting_mind"
# Set true when the database provider requires TLS.
DATABASE_SSL="false"
